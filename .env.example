# Salin menjadi .env lalu sesuaikan bila perlu.
JWT_SECRET=simulasi-dev-jwt-secret-change-me
GATEWAY_SECRET=simulasi-gateway-secret-change-me

# Masa berlaku token
ACCESS_TOKEN_TTL=10m
SERVICE_TOKEN_TTL=5m
REFRESH_TOKEN_TTL_MS=86400000

# Port dan alamat
GATEWAY_PORT=3000
NILAI_PORT=3001
TRANSKRIP_PORT=3002
GATEWAY_URL=http://127.0.0.1:3000
NILAI_URL=http://127.0.0.1:3001
TRANSKRIP_URL=http://127.0.0.1:3002

# Jam akses untuk ubah dan finalisasi nilai (format 24 jam).
# Contoh demo penolakan: ACCESS_START_HOUR=22 dan ACCESS_END_HOUR=23.
ACCESS_START_HOUR=7
ACCESS_END_HOUR=21

# Kredensial service-to-service
SERVICE_CLIENT_ID=service-nilai
SERVICE_CLIENT_SECRET=nilai-secret-2026

# Lokasi database (opsional)
# DB_PATH=./data/simulasi.db
